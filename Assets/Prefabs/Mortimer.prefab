  conversations:
  - requires: 
    notIf: found:mortimer
    sets: found:mortimer,+moles_found
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Mmm? Is it Tuesday? I sat down for a tiny nap behind this rock. Digby sent you? Tell him I'll be right along. Just... five more minutes.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: It IS Tuesday. I knew it.
