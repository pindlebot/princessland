--- !u!114 &5965414038087660596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4408909827911434194}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993d8d8b34a954049b05eb7b4bbba012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game::Npc
  npcName: Old Stitches
  portrait: {fileID: 21300000, guid: 4bb4d9eb6413b4f2c9c9c0b1d0718cd9, type: 3}
  voice: {fileID: 8300000, guid: 0ded5da089b494eb7ae5c2cdf49e81fa, type: 3}
  giftSound: {fileID: 8300000, guid: a142d3c7adcfa46989d2fae3161d654d, type: 3}
  conversations:
  - requires: 
    notIf: met:Old Stitches
    sets: met:Old Stitches
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Boo! ...Ha! Got you! Don't worry, I'm only a scarecrow. Old Stitches, they call me.
    - heroSpeaks: 1
      text: A talking scarecrow?!
    - heroSpeaks: 0
      text: Welcome to Hollow Farm, {hero}! Some folk say it's haunted. They're right! But our ghosts are ever so friendly.
    - heroSpeaks: 0
      text: They float about the old graveyard at dusk, playing hide-and-seek in the mist. Say boo to them. They love it.
    - heroSpeaks: 0
      text: Just don't mind the crows. I'm supposed to scare them, but we're good friends really.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Why did the scarecrow win a prize?
    - heroSpeaks: 1
      text: Why?
    - heroSpeaks: 0
      text: Because he was OUTSTANDING in his field! Ha!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Those pumpkins grew all by themselves. The ghosts carve the faces at night. Nobody knows how they hold the knives!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: I'd offer you a hug, but I'm mostly straw. Very scratchy. Here, have a wave instead!
  - requires: met:Barnaby
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    takeItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Barnaby Badger came by for pumpkins once. He said they'd make lovely soup. I said they make lovely FACES.
  talkOffset: {x: 0, y: 0, z: 0}
  flipbook: {fileID: 4239500143933895513}
  idleFrames:
  - {fileID: -174425047, guid: 6f3f7055ae7064389959a40ce3b46ef8, type: 3}
  - {fileID: -998118808, guid: 6f3f7055ae7064389959a40ce3b46ef8, type: 3}
