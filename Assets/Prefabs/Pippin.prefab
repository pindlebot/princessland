  m_EditorClassIdentifier: Game::Merchant
  npcName: Pippin
  portrait: {fileID: 21300000, guid: d2f54533247854073ad568fe300c444b, type: 3}
  voice: {fileID: 8300000, guid: e5390ee1a72604b8dbc8c7316811a5e4, type: 3}
  giftSound: {fileID: 8300000, guid: a142d3c7adcfa46989d2fae3161d654d, type: 3}
  conversations:
  - requires: 
    notIf: met:Pippin
    sets: met:Pippin
    giveGold: 0
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Ooooh! A visitor! Welcome to the Autumn Festival! I'm Pippin.
    - heroSpeaks: 1
      text: You're a ghost... running a cider stand?
    - heroSpeaks: 0
      text: Best hot apple cider in the whole kingdom! I stir it with my ghostly ladle. Three coins a mug.
    - heroSpeaks: 0
      text: Drink it whenever you're tired. It'll warm you right up! Oh, and have you tried the corn maze?
    - heroSpeaks: 0
      text: They say there's a glowing hat at the very middle. Nobody's found it yet... nobody ALIVE, anyway! Hee hee!
  talkOffset: {x: 0, y: 0, z: -1}
  flipbook: {fileID: 1932076583022393958}
