  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993d8d8b34a954049b05eb7b4bbba012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game::DragonNpc
  npcName: Amethyra
  portrait: {fileID: 21300000, guid: 7f267f10f48ab4afe93f0f8e408f159c, type: 3}
  introduction:
  - heroSpeaks: 0
    text: Well now, a visitor! Don't be frightened, {hero}. I don't bite... often.
  - heroSpeaks: 1
    text: A dragon?! Here, at the castle?
  - heroSpeaks: 0
    text: I am Amethyra, last of the amethyst dragons. I've watched over this castle for three hundred years.
  - heroSpeaks: 0
    text: Those rattling skeletons crawled up from the dungeon below. Clear them away, and the way down will open.
  - heroSpeaks: 1
    text: Won't you come and help?
  - heroSpeaks: 0
    text: My fighting days are long behind me, little one. But I'll be right here, cheering you on. Go on, {hero}!
  laterChat:
  - heroSpeaks: 0
    text: 'Back again, {hero}? The way down lies past my castle. Mind those skeletons: all bones and bad manners.'
  flipbook: {fileID: 3465369928831926180}
  idleFrames:
  - {fileID: 1013168404, guid: b12f0622f36ab4fe584084408505c263, type: 3}
  - {fileID: 823873838, guid: b12f0622f36ab4fe584084408505c263, type: 3}
  - {fileID: 651522108, guid: b12f0622f36ab4fe584084408505c263, type: 3}
