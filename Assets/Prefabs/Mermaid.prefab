  - {fileID: -1002956325, guid: 6516db6699af84ff7a7601c62eb6c202, type: 3}
  talkFrames:
  - {fileID: 901302284, guid: 6516db6699af84ff7a7601c62eb6c202, type: 3}
  - {fileID: -1821474954, guid: 6516db6699af84ff7a7601c62eb6c202, type: 3}
  idleFps: 4
  talkFps: 8
