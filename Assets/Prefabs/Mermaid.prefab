--- !u!114 &782762046866222567
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4211291585249948201}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993d8d8b34a954049b05eb7b4bbba012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game::Npc
  npcName: Coralie
  portrait: {fileID: 21300000, guid: 8be7ccfcffc8b4af78456a2c3a81fadf, type: 3}
  voice: {fileID: 8300000, guid: e5390ee1a72604b8dbc8c7316811a5e4, type: 3}
  giftSound: {fileID: 8300000, guid: a142d3c7adcfa46989d2fae3161d654d, type: 3}
  conversations:
  - requires: found:frog
    notIf: thanked:frog
    sets: thanked:frog,met:Coralie
    giveGold: 20
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 1
      text: Excuse me, Miss Mermaid! Is this little frog yours? He was hiding in a bush.
    - heroSpeaks: 0
      text: Sir Hopsalot! You found him! He's my very best friend, and he ALWAYS hides too well.
    - heroSpeaks: 0
      text: I'm Coralie. Thank you so much, {hero}! Please take these sea-coins. They're extra shiny.
  - requires: 
    notIf: met:Coralie
    sets: met:Coralie
    giveGold: 0
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Splish splash! Oh, hello there! I'm Coralie. I swam all the way up the river to visit this pond.
    - heroSpeaks: 1
      text: A real mermaid! Do you live here?
    - heroSpeaks: 0
      text: Only for the summer. The lily pads are ever so comfy.
    - heroSpeaks: 0
      text: Say, {hero}... have you seen my friend Sir Hopsalot? He's a little green frog with a tiny crown.
    - heroSpeaks: 0
      text: He LOVES hiding in bushes. If you find him, will you tell me?
    - heroSpeaks: 1
      text: I'll keep my eyes open!
  - requires: 
    notIf: found:frog
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Still no sign of Sir Hopsalot? Try rustling the bushes. He likes the ones in the corners.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Did you know? If you toss coins into the fountain and make a wish, sometimes wishes come true!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: 'Mermaid tip: always brush your hair with a fork. Wait... that''s not right, is it? Hee hee!'
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Sir Hopsalot says ribbit. That means 'thank you' in Frog.
    - heroSpeaks: 1
      text: Ribbit!
    - heroSpeaks: 0
      text: Oh! You speak Frog too!
  - requires: wish:granted
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: A wish came true at the fountain! The water sparkled all the way into my pond!
  - requires: 
    notIf: met:Pearl
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: My big sister Pearl lives in Mermaid Cove, down the river. I haven't heard from her in ages...
    - heroSpeaks: 0
      text: The rowboat at the corner of my pond goes all the way there. Would you check on her, {hero}?
  - requires: thanked:cove
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Pearl told me everything! You broke the sea-spell AND scared off the pirates. You're my hero, {hero}!
  talkOffset: {x: 0, y: 0, z: 0}
  flipbook: {fileID: 2530459861725407900}
  idleFrames:
  - {fileID: -1791398350, guid: 6516db6699af84ff7a7601c62eb6c202, type: 3}
  - {fileID: -1253362484, guid: 6516db6699af84ff7a7601c62eb6c202, type: 3}
