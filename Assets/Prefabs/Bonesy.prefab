--- !u!114 &8620793177928243896
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7683189849697679796}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993d8d8b34a954049b05eb7b4bbba012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game::Npc
  npcName: Bonesy
  portrait: {fileID: 21300000, guid: 556252dc34aed49a9b4f4a30085d9391, type: 3}
  voice: {fileID: 8300000, guid: 3f7c7fa337ff841f287e4d2bf1e0b3fd, type: 3}
  giftSound: {fileID: 8300000, guid: a142d3c7adcfa46989d2fae3161d654d, type: 3}
  conversations:
  - requires: 
    notIf: met:Bonesy
    sets: met:Bonesy
    giveGold: 0
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Eek! Please don't zap me! I'm not like the others, honest!
    - heroSpeaks: 1
      text: You're... a friendly skeleton?
    - heroSpeaks: 0
      text: I'm Bonesy. I don't like fighting. I just like campfires, and humming, and my scarf.
    - heroSpeaks: 0
      text: Warm up by the fire whenever you like. It makes you feel all better.
    - heroSpeaks: 0
      text: Oh, and somebody dropped a rusty key down in the twisty tunnels below. I wonder what it opens...
  - requires: key:rusty
    notIf: bonesy:key
    sets: bonesy:key
    giveGold: 0
    giveItem: 
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: You found the rusty key! I think it opens the big door at the end of the long hall, past the barrels.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Why didn't the skeleton cross the road?
    - heroSpeaks: 1
      text: Why?
    - heroSpeaks: 0
      text: He didn't have the GUTS! Hee hee hee!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Rattle rattle. Sorry, that's just my knees.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    giveItem: 
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: The Slime King lives past the great big puddle. He's very wobbly, and very grumpy.
  talkOffset: {x: 0, y: 0, z: 0}
  flipbook: {fileID: 3765144964710709323}
  idleFrames:
  - {fileID: -160758054, guid: eb4b27ce40730431695d2dd7182ba6d5, type: 3}
  - {fileID: -1904290602, guid: eb4b27ce40730431695d2dd7182ba6d5, type: 3}
