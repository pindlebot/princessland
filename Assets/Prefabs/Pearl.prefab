--- !u!114 &668236530052888816
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6915241358653129004}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 993d8d8b34a954049b05eb7b4bbba012, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Game::Npc
  npcName: Pearl
  portrait: {fileID: 21300000, guid: 13c1093a2d7574b69b9c15efdf7781a9, type: 3}
  voice: {fileID: 8300000, guid: e5390ee1a72604b8dbc8c7316811a5e4, type: 3}
  giftSound: {fileID: 8300000, guid: a142d3c7adcfa46989d2fae3161d654d, type: 3}
  conversations:
  - requires: cleared:Cove
    notIf: thanked:cove
    sets: thanked:cove,met:Pearl
    giveGold: 30
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: You did it, {hero}! The sea-spell is broken. My friends are themselves again, and they're SO embarrassed.
    - heroSpeaks: 0
      text: And the pirates rowed off in such a hurry, they left their secret stair in the sea cave wide open!
    - heroSpeaks: 0
      text: Here, take these sea-coins. Coralie will want to hear all about this!
  - requires: 
    notIf: met:Pearl
    sets: met:Pearl
    giveGold: 0
    smallTalk: 0
    lines:
    - heroSpeaks: 0
      text: Eep! Quick, hide behind a palm tree! ...Oh. You're not a pirate. Phew!
    - heroSpeaks: 0
      text: I'm Pearl, Coralie's big sister. Welcome to Mermaid Cove, {hero}.
    - heroSpeaks: 1
      text: Coralie, from the castle pond? She's lovely!
    - heroSpeaks: 0
      text: She is! But a band of pirates sailed in last week. Their captain has a grumpy old sea-spell, and he cast it on my friends.
    - heroSpeaks: 0
      text: Now they glow, and sulk, and throw dark bolts at everybody. They don't really mean it!
    - heroSpeaks: 0
      text: 'Break the spell with your magic, and chase those pirates off our beaches. Mind the bolts: step aside when you see one coming!'
    - heroSpeaks: 1
      text: Leave it to me!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: The waterfalls come all the way down from the clouds. Coralie swam UP one once. Show-off.
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: The pirates keep their treasure in the sea cave, past the stream. Be careful in there!
  - requires: 
    notIf: 
    sets: 
    giveGold: 0
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: Why are pirates called pirates?
    - heroSpeaks: 1
      text: Why?
    - heroSpeaks: 0
      text: Because they ARRR! Hee hee!
  - requires: found:frog
    notIf: 
    sets: 
    giveGold: 0
    smallTalk: 1
    lines:
    - heroSpeaks: 0
      text: 'A seagull brought a letter from Coralie: you found Sir Hopsalot! He''s the bravest frog in the world.'
  talkOffset: {x: 0, y: 0, z: 0}
  flipbook: {fileID: 3105894835443985322}
  idleFrames:
  - {fileID: -1121348060, guid: 038106d8d5a844e80b4c98b5aae8d30c, type: 3}
  - {fileID: 1412741141, guid: 038106d8d5a844e80b4c98b5aae8d30c, type: 3}
  - {fileID: -1876345591, guid: 038106d8d5a844e80b4c98b5aae8d30c, type: 3}
  - {fileID: 1364112204, guid: 038106d8d5a844e80b4c98b5aae8d30c, type: 3}
