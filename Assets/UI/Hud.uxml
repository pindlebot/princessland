<!--
  The HUD layout. UXML is to UI Toolkit what HTML is to a web page: it only says
  what elements exist and how they nest. Hud.uss styles them (storybook style: cream
  panels, honey-gold borders, plum text, four-point stars on the main cards only);
  HudController.cs finds them by name and
  updates them every frame. Most of the HUD uses picking-mode="Ignore" so clicks pass
  through to the game; panels you click (inventory, skills) don't.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Hud.uss" />

    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">

        <!-- A red glow around the screen's edges, flashed when the hero is hit (under everything else) -->
        <ui:VisualElement name="hurt-flash" class="hurt-flash" picking-mode="Ignore" />

        <!-- Top left: the hero's status card. Who you are (portrait + name) and how you're doing
             (hearts, then magic beneath), with level, coins and skill points in a quieter footer. -->
        <ui:VisualElement name="status" class="panel panel-star status" picking-mode="Ignore">
            <ui:VisualElement class="status-main" picking-mode="Ignore">
                <ui:VisualElement class="portrait-frame" picking-mode="Ignore">
                    <ui:VisualElement name="portrait" class="portrait" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="status-body" picking-mode="Ignore">
                    <ui:Label name="player-name" class="player-name" text="Hero" />
                    <!-- One heart per point of health (HudController builds them); smaller past 8,
                         and past 12 a single heart with a count, so they never wrap -->
                    <ui:VisualElement class="hearts-row" picking-mode="Ignore">
                        <ui:VisualElement name="hearts" class="hearts" picking-mode="Ignore" />
                        <ui:Label name="hearts-count" class="hearts-count" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="magic-row" picking-mode="Ignore">
                        <ui:VisualElement class="magic-icon" picking-mode="Ignore" />
                        <ui:VisualElement class="bar magic-bar" picking-mode="Ignore">
                            <ui:VisualElement name="mana-fill" class="bar-fill mana" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- The footer: smaller and quieter, under a running stitch -->
            <ui:VisualElement class="stitch" picking-mode="Ignore" />
            <ui:VisualElement class="secondary-row" picking-mode="Ignore">
                <ui:Label name="level-badge" class="level-badge" text="1" />
                <ui:VisualElement class="bar xp-bar" picking-mode="Ignore">
                    <ui:VisualElement name="xp-fill" class="bar-fill xp" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="gold-icon" picking-mode="Ignore" />
                <ui:Label name="gold-text" class="gold-text" text="0" />
                <ui:Label name="points-hint" class="points-hint" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top middle: the boss's health bar, shown once it notices you -->
        <ui:VisualElement class="centered-row boss-row" picking-mode="Ignore">
            <ui:VisualElement name="boss-bar" class="panel boss-bar" picking-mode="Ignore">
                <ui:Label name="boss-name" class="boss-name" text="Boss" picking-mode="Ignore" />
                <ui:VisualElement class="bar boss-health" picking-mode="Ignore">
                    <ui:VisualElement name="boss-fill" class="bar-fill boss" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top right: a small minimap. The map image is rotated to match the camera; the round frame
             clips it, and the ring (with a star at the top: "up the screen") sits over the edge. -->
        <ui:VisualElement class="minimap-box" picking-mode="Ignore">
            <ui:VisualElement name="minimap-frame" class="minimap-frame" picking-mode="Ignore">
                <ui:VisualElement name="minimap" class="minimap" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="minimap-ring" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Top right, under the minimap: where you are and what to do, in as few words as possible -->
        <ui:VisualElement name="objective" class="panel panel-star objective" picking-mode="Ignore">
            <ui:Label name="objective-title" class="objective-title" text="The Castle Grounds" />
            <ui:VisualElement name="objective-monsters" class="objective-monsters" picking-mode="Ignore">
                <ui:VisualElement class="monster-icon" picking-mode="Ignore" />
                <ui:Label name="enemies-left" class="enemies-left" text="6 monsters left" />
            </ui:VisualElement>
            <ui:VisualElement name="objective-pips" class="objective-pips" picking-mode="Ignore" />
            <ui:Label name="objective-hint" class="objective-hint" text="" />
        </ui:VisualElement>

        <!-- Inventory (press I), on the left under the status card. On the left, the hero as a paper doll with
             each worn slot sitting on the part of the body it dresses (HudController finds each by name:
             equip-<slot>); on the right, the stats, the bag and the treasures. What an item is and does shows in the
             floating tooltip (item-tooltip), not down here. -->
        <ui:VisualElement name="inventory" class="panel inventory">
            <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                <ui:Label class="inventory-title" text="Inventory" />
                <ui:Label class="inventory-close" text="I: close" />
            </ui:VisualElement>
            <ui:VisualElement class="inventory-body" picking-mode="Ignore">
                <ui:VisualElement name="doll" class="doll" picking-mode="Ignore">
                    <ui:VisualElement name="doll-figure" class="doll-figure" picking-mode="Ignore" />
                <ui:VisualElement name="equip-hat" class="slot inv-slot equip-slot doll-slot doll-hat"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-helm" class="slot inv-slot equip-slot doll-slot doll-helm"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-charm" class="slot inv-slot equip-slot doll-slot doll-charm"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-armor" class="slot inv-slot equip-slot doll-slot doll-armor"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-weapon" class="slot inv-slot equip-slot doll-slot doll-weapon"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-ring" class="slot inv-slot equip-slot doll-slot doll-ring"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                <ui:VisualElement name="equip-boots" class="slot inv-slot equip-slot doll-slot doll-boots"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="inventory-side" picking-mode="Ignore">
                    <ui:VisualElement class="equip-info" picking-mode="Ignore">
                        <ui:Label name="stat-damage" class="stat-line" text="Fireball damage: 1" />
                        <ui:Label name="stat-gear" class="stat-line gear" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tab-row" picking-mode="Ignore">
                        <ui:Label name="tab-bag" class="tab active" text="Bag" />
                        <ui:Label name="tab-treasures" class="tab" text="Treasures" />
                    </ui:VisualElement>
                    <ui:VisualElement name="bag" class="bag" picking-mode="Ignore">
                    <ui:VisualElement name="bag-0" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-1" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-2" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-3" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-4" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-5" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-6" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="bag-7" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    </ui:VisualElement>
                    <!-- The treasures tab: key items (abilities, lanterns, gems), shown instead of the bag -->
                    <ui:VisualElement name="treasures" class="bag" picking-mode="Ignore">
                    <ui:VisualElement name="key-0" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-1" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-2" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-3" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-4" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-5" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-6" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-7" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-8" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-9" class="slot inv-slot"><ui:VisualElement class="slot-icon" picking-mode="Ignore" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="item-details" class="item-details" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The item tooltip: follows the pointer over any item slot (HudController.ShowTip) -->
        <ui:VisualElement name="item-tooltip" class="panel item-tooltip" picking-mode="Ignore">
            <ui:Label name="tip-name" class="tip-name" text="" picking-mode="Ignore" />
            <ui:Label name="tip-kind" class="tip-kind" text="" picking-mode="Ignore" />
            <ui:Label name="tip-desc" class="tip-desc" text="" picking-mode="Ignore" />
            <ui:Label name="tip-stats" class="tip-stats" text="" picking-mode="Ignore" />
            <ui:Label name="tip-action" class="tip-action" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Skill tree (press K). SkillTreeView builds the hero's path of nodes from SkillCatalog. -->
        <ui:VisualElement class="centered-row skills-row" picking-mode="Ignore">
            <ui:VisualElement name="skills" class="panel skills">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label class="inventory-title" text="Skills" />
                    <ui:Label name="skill-points" class="skill-points" text="Points: 0" />
                    <ui:Label class="inventory-close" text="K: close" />
                </ui:VisualElement>
                <ui:VisualElement name="skill-branches" class="skill-branches" picking-mode="Ignore" />
                <ui:Label name="skill-details" class="item-details skill-details" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Quest log (press J). QuestLogView builds one card per quest from QuestCatalog. -->
        <ui:VisualElement class="centered-row quests-row" picking-mode="Ignore">
            <ui:VisualElement name="quests" class="panel quests">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label class="inventory-title" text="Quests" />
                    <ui:Label class="inventory-close" text="J: close" />
                </ui:VisualElement>
                <ui:Label name="quest-empty" class="item-details quest-empty" text="" picking-mode="Ignore" />
                <ui:VisualElement name="quest-list" class="quest-list" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The world map (press M): WorldMapView paints the rooms you've visited into the canvas. -->
        <ui:VisualElement class="centered-row worldmap-row" picking-mode="Ignore">
            <ui:VisualElement name="worldmap" class="panel worldmap">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label class="inventory-title" text="World map" />
                    <ui:Label class="inventory-close" text="M: close" />
                </ui:VisualElement>
                <ui:VisualElement name="world-canvas" class="world-canvas" picking-mode="Ignore" />
                <ui:Label name="world-legend" class="item-details" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Fountains (press T beside one): rest and save, or travel to another fountain you've touched.
             FountainTravelView builds the rows. -->
        <ui:VisualElement class="centered-row fountain-row" picking-mode="Ignore">
            <ui:VisualElement name="fountain-menu" class="panel panel-star fountain-menu">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label class="inventory-title" text="Fountain" />
                    <ui:Label name="fountain-close" class="inventory-close fountain-close" text="Esc / B: close" />
                </ui:VisualElement>
                <ui:VisualElement name="fountain-list" class="fountain-list" />
                <ui:Label name="fountain-message" class="item-details" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Cooking (at the kitchen stove): one recipe card. CookingView builds the card's insides. -->
        <ui:VisualElement class="centered-row cooking-row" picking-mode="Ignore">
            <ui:VisualElement name="cooking" class="panel cooking">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label name="cooking-title" class="inventory-title" text="Cooking" />
                    <ui:Label name="cooking-close" class="inventory-close cooking-close" text="Esc / B: close" />
                </ui:VisualElement>
                <ui:VisualElement name="recipe-card" class="recipe-card" picking-mode="Ignore" />
                <ui:Label name="cooking-message" class="item-details cooking-message" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Help (press H): the full controls list, out of the way until asked for -->
        <ui:VisualElement class="centered-row help-row" picking-mode="Ignore">
            <ui:VisualElement name="help" class="panel help" picking-mode="Ignore">
                <ui:VisualElement class="inventory-header" picking-mode="Ignore">
                    <ui:Label class="inventory-title" text="How to play" />
                    <ui:Label class="inventory-close" text="H: close" />
                </ui:VisualElement>
                <ui:Label class="help-line" text="W A S D or stick:  walk" />
                <ui:Label class="help-line" text="Space, Click or X:  magic! (it aims by itself)" />
                <ui:Label class="help-line" text="Q or LB,  F or LT:  abilities from the skill path" />
                <ui:Label class="help-line" text="E or A:  open, talk, pick up" />
                <ui:Label class="help-line" text="I or Y:  bag      K or View:  skills      J or R3:  quests" />
                <ui:Label class="help-line" text="2 3 4 5 or right stick:  eat from the hotbar      T or L3:  fountain" />
                <ui:Label class="help-line" text="M:  world map (also in the pause menu)" />
                <ui:Label class="help-line" text="H or RB:  this help      R:  try again" />
                <ui:Label class="help-line" text="Esc or Start:  pause menu" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom: the spell in the middle, the help pill in the corner -->
        <ui:VisualElement class="bottom-row" picking-mode="Ignore">
            <ui:VisualElement name="hotbar" class="hotbar" picking-mode="Ignore">
                <!-- The hero's spell: one clear slot -->
                <ui:VisualElement class="hotbar-item" picking-mode="Ignore">
                    <ui:VisualElement name="slot-spell" class="slot spell-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:VisualElement name="spell-cooldown" class="slot-cooldown" picking-mode="Ignore" />
                        <ui:Label name="spell-cost" class="slot-cost" text="10" picking-mode="Ignore" />
                        <!-- A four-point star that flashes as the spell goes off -->
                        <ui:VisualElement name="spell-flash" class="spell-flash" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="spell-key" class="spell-key" text="Space" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- The abilities from the skill path (steps 3 and 4): hidden until learned -->
                <ui:VisualElement name="ability-2" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="slot-2" class="slot ability-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="20" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="Q" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="ability-3" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="slot-3" class="slot ability-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:VisualElement class="slot-cooldown" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="30" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="F" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- Consumables from the bag, on keys 2-5: hidden until something is on the slot -->
                <ui:VisualElement name="quick-0" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="quick-slot-0" class="slot ability-slot quick-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="2" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="quick-1" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="quick-slot-1" class="slot ability-slot quick-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="3" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="quick-2" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="quick-slot-2" class="slot ability-slot quick-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="4" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="quick-3" class="hotbar-item future-slot" picking-mode="Ignore">
                    <ui:VisualElement name="quick-slot-3" class="slot ability-slot quick-slot">
                        <ui:VisualElement class="slot-icon" picking-mode="Ignore" />
                        <ui:Label class="slot-cost" text="1" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="spell-key" text="5" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="bottom-right" picking-mode="Ignore">
                <ui:Label name="help-pill" class="panel help-pill" text="H: Help" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- One short hint at a time: "E: Open chest", "Space: Magic!", "W A S D: Walk" -->
        <ui:VisualElement class="centered-row prompt-row" picking-mode="Ignore">
            <ui:Label name="interact-prompt" class="panel interact-prompt" text="E: Open chest" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Short messages like "Level up!" that fade in and out -->
        <ui:VisualElement class="centered-row toast-row" picking-mode="Ignore">
            <ui:Label name="toast" class="panel toast" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Conversations (DialogueController). The portrait swaps sides when the hero speaks. -->
        <ui:VisualElement class="centered-row dialogue-row" picking-mode="Ignore">
            <ui:VisualElement name="dialogue" class="dialogue" picking-mode="Ignore">
                <ui:VisualElement class="panel dialogue-portrait-frame" picking-mode="Ignore">
                    <ui:VisualElement name="dialogue-portrait" class="dialogue-portrait" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="panel panel-star dialogue-box" picking-mode="Ignore">
                    <ui:Label name="dialogue-speaker" class="dialogue-speaker" picking-mode="Ignore" />
                    <ui:Label name="dialogue-text" class="dialogue-text" picking-mode="Ignore" />
                    <ui:Label name="dialogue-hint" class="dialogue-hint" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Win/lose banner, hidden until the game ends (HudController toggles .visible) -->
        <ui:VisualElement class="centered-row banner-row" picking-mode="Ignore">
            <ui:VisualElement name="banner" class="panel banner" picking-mode="Ignore">
                <ui:Label name="banner-title" class="banner-title" text="You died" />
                <ui:Label name="banner-subtitle" class="banner-subtitle" text="R: try again      Esc: menu" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Gentle Mode's nap: a dreamy fade over everything (HudController sets its opacity) -->
        <ui:VisualElement name="sleep-fade" class="sleep-fade" picking-mode="Ignore">
            <ui:Label class="sleep-text" text="Zzz..." />
            <ui:Label class="sleep-subtext" text="So sleepy... time for a little nap." />
        </ui:VisualElement>

        <!-- Drawn last so it covers everything else. -->
        <!-- Pause menu (Esc / Start): PauseMenu.cs. Each setting row is: name, <, value, > -->
        <ui:VisualElement name="pause-screen" class="pause-screen">
            <ui:VisualElement class="panel panel-star pause">
                <ui:Label class="pause-title" text="Paused" />
                <ui:Button name="pause-resume" class="pause-row pause-button" text="Keep playing" />
                <ui:VisualElement name="pause-music" class="pause-row">
                    <ui:Label class="pause-name" text="Music" />
                    <ui:Button class="pause-less" text="&lt;" />
                    <ui:VisualElement name="pause-music-value" class="pause-value pause-dots" />
                    <ui:Button class="pause-more" text="&gt;" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-sounds" class="pause-row">
                    <ui:Label class="pause-name" text="Sounds" />
                    <ui:Button class="pause-less" text="&lt;" />
                    <ui:VisualElement name="pause-sounds-value" class="pause-value pause-dots" />
                    <ui:Button class="pause-more" text="&gt;" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-mode" class="pause-row">
                    <ui:Label class="pause-name" text="Mode" />
                    <ui:Button class="pause-less" text="&lt;" />
                    <ui:Label name="pause-mode-value" class="pause-value" />
                    <ui:Button class="pause-more" text="&gt;" />
                </ui:VisualElement>
                <ui:Label name="pause-mode-description" class="pause-description" />
                <ui:Button name="pause-map" class="pause-row pause-button" text="World map" />
                <ui:Button name="pause-quit" class="pause-row pause-button" text="Save and go to title" />
                <ui:Button name="pause-exit" class="pause-row pause-button" text="Save and quit game" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
