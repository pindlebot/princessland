/*
  HUD styles: a warm storybook look. USS is CSS for UI Toolkit: selectors, classes, flexbox.

  The visual rules live in :root below (they mirror Tools/palette.py and Scripts/ArtStyle.cs):
  one panel image, one border and shadow treatment, one type scale, one screen margin.

  Every box uses the same 9-sliced PanelCream.png (cream paper, plum outline, honey frame, a
  fine embroidered thread, a soft plum shadow baked in below). The main cards (status,
  objective, dialogue, pause) use PanelStar.png instead: the same, with two little four-point
  stars on the top corners. That's the only place the stars go on panels, so they stay special.
  The storybook art (panel, hearts, icons) is drawn smooth at 4x its on-screen size
  (Tools/make_hud_sprites.py), so it stays sharp on big screens: -unity-slice-* marks the panel's
  40px (texture) border so it doesn't stretch, and -unity-slice-scale: 0.25px draws that border
  10px wide (12px along the bottom, where the shadow is). Text sits on these panels rather than
  straight over the scenery, so it stays readable anywhere.
*/

:root {
    /* Ink */
    --ink: rgb(74, 37, 69);            /* text and outlines */
    --ink-soft: rgb(128, 88, 118);     /* labels, secondary text */
    /* Paper and trim */
    --cream: rgb(248, 239, 216);
    --cream-shade: rgb(232, 218, 188);
    --honey: rgb(222, 168, 70);
    --honey-light: rgb(250, 214, 120);
    --honey-shade: rgb(164, 112, 40);
    /* Resources: health is coral-red, magic turquoise, experience lavender, coins gold */
    --heart: rgb(232, 70, 92);
    --magic: rgb(64, 206, 210);
    --magic-light: rgb(196, 250, 246);
    --xp: rgb(170, 130, 210);
    --xp-light: rgb(214, 190, 240);
    --coin-text: rgb(150, 100, 20);
    --good: rgb(46, 140, 70);          /* "you can do this now": skill points, the open stairs */
    /* Type scale: four sizes, used everywhere */
    --text-title: 18px;
    --text-body: 15px;
    --text-label: 13px;
    --text-small: 11px;
    /* Spacing */
    --margin: 14px;                    /* from the screen edges */
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Hit! The edges glow red for a moment (HudController adds .visible briefly).
   A transition uses the timing of the state it's going *to*: quick in, slow fade out. */
.hurt-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/UI/HurtVignette.png");
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.45s;
}

.hurt-flash.visible {
    opacity: 1;
    transition-duration: 0.05s;
}

Label {
    color: var(--ink);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* ---------- The one panel style ---------- */

.panel,
.frame {
    background-image: url("project://database/Assets/Art/UI/PanelCream.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 48; /* the 10px frame plus its 2px shadow */
    -unity-slice-scale: 0.25px;
    padding: 10px 14px 12px 14px;
}

/* The main cards: the same panel with a four-point star on each top corner */
.panel-star {
    background-image: url("project://database/Assets/Art/UI/PanelStar.png");
}

/* The embroidered running stitch, as a divider: one 6x2 stitch, repeated across */
.stitch {
    height: 2px;
    margin: 7px 2px 6px 2px;
    background-image: url("project://database/Assets/Art/UI/StitchRule.png");
    background-repeat: repeat-x;
    background-size: 6px 2px;
}

/* Rows that center their child across the screen (a positioned label would stretch) */
.centered-row {
    position: absolute;
    left: 0;
    right: 0;
    align-items: center;
}

/* ---------- Objective (top right, under the minimap) ---------- */

.objective {
    position: absolute;
    right: var(--margin);
    top: 166px; /* under the minimap */
    min-width: 210px;
    padding: 10px 16px 14px 14px;
    transition-property: scale;
    transition-duration: 0.15s;
}

/* A little bounce when the stairs open (HudController toggles .celebrate a few times) */
.objective.celebrate {
    scale: 1.08 1.08;
}

.objective-title {
    font-size: var(--text-label);
    color: var(--ink-soft);
    margin-bottom: 4px;
}

.objective-monsters {
    flex-direction: row;
    align-items: center;
}

.monster-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/IconMonster.png");
}

.enemies-left {
    font-size: var(--text-title);
}

/* Progress markers: a grey monster each, turning into a gold star as it's defeated */
.objective-pips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
    max-width: 230px;
}

.pip {
    width: 18px;
    height: 18px;
    margin: 0 3px 3px 0;
    background-image: url("project://database/Assets/Art/UI/PipMonster.png");
}

.pip.defeated {
    background-image: url("project://database/Assets/Art/UI/PipStar.png");
}

.objective-hint {
    font-size: var(--text-body);
    margin-top: 4px;
}

.objective-hint.open {
    color: var(--good);
    font-size: var(--text-title);
}

/* ---------- Boss health bar (top middle) ---------- */

.boss-row {
    top: var(--margin);
}

.boss-bar {
    width: 320px; /* narrow enough to fit between the status card and the minimap at 1024 wide */
    padding: 8px 18px 10px 18px;
    align-items: center;
    display: none;
}

.boss-bar.visible {
    display: flex;
}

.boss-name {
    font-size: var(--text-body);
    margin-bottom: 4px;
}

.boss-health {
    width: 280px;
    height: 16px;
}

.bar-fill.boss {
    background-color: rgb(150, 70, 200);
    border-top-color: rgb(210, 160, 240);
}

/* ---------- Minimap (top right): small and round, framed like the rest ---------- */

.minimap-box {
    position: absolute;
    right: var(--margin);
    top: var(--margin);
    width: 140px;
    height: 144px; /* the ring's shadow hangs a little below */
}

/* The round window onto the map. Its background is set by Minimap.cs to the scene's own
   backdrop (sky around the island, darkness in the dungeon), so the shape reads the same. */
.minimap-frame {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(176, 212, 228);
    overflow: hidden; /* clips the map to the circle */
}

/* Honey ring with the running stitch and a star at the top, over the window's edge */
.minimap-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 140px;
    height: 140px;
    background-image: url("project://database/Assets/Art/UI/MinimapRing.png");
}

.minimap {
    position: absolute; /* size, position and rotation are set every frame by Minimap.cs */
}

/* Upright markers over the turning terrain (positions set by Minimap.cs) */
.minimap-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Each icon is 3x its pixel art and centred on its spot with whole-pixel margins
   (a -50% translate would land odd sizes on half pixels and blur them). */
.map-marker {
    position: absolute;
}

.map-crown { width: 33px; height: 24px; margin-left: -16px; margin-top: -12px; background-image: url("project://database/Assets/Art/UI/MapCrown.png"); }
.map-stairs { width: 21px; height: 18px; margin-left: -10px; margin-top: -9px; background-image: url("project://database/Assets/Art/UI/MapStairs.png"); }
.map-stairs-locked { width: 21px; height: 18px; margin-left: -10px; margin-top: -9px; background-image: url("project://database/Assets/Art/UI/MapStairsLocked.png"); }
.map-monster { width: 15px; height: 12px; margin-left: -7px; margin-top: -6px; background-image: url("project://database/Assets/Art/UI/MapMonster.png"); }
.map-chest { width: 15px; height: 12px; margin-left: -7px; margin-top: -6px; background-image: url("project://database/Assets/Art/UI/MapChest.png"); }
.map-dragon { width: 15px; height: 15px; margin-left: -7px; margin-top: -7px; background-image: url("project://database/Assets/Art/UI/MapDragon.png"); }

/* ---------- Bars (magic, experience, boss) ---------- */

.bar {
    background-color: var(--cream-shade);
    border-width: 2px;
    border-color: var(--ink);
    border-radius: 8px;
    overflow: hidden;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-top-width: 3px;
    transition-property: width; /* bars slide instead of jumping */
    transition-duration: 0.2s;
}

.bar-fill.mana {
    background-color: var(--magic);
    border-top-color: var(--magic-light);
}

.bar-fill.xp {
    background-color: var(--xp);
    border-top-width: 1px;
    border-top-color: var(--xp-light);
}

/* ---------- Bottom row ---------- */

.bottom-row {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    bottom: var(--margin);
    flex-direction: row;
    align-items: flex-end;
    justify-content: center; /* the spell slot */
}

.bottom-right {
    position: absolute;
    right: 0;
    bottom: 0;
}

/* ---------- Status card (top left) ----------
   Portrait and name together, hearts, then magic beneath; level, experience, coins and skill
   points in a quieter footer under a running stitch. */

.status {
    position: absolute;
    left: var(--margin);
    top: var(--margin);
    width: 300px;
    padding: 10px 14px 12px 10px;
}

.status-main {
    flex-direction: row;
    align-items: center;
}

.portrait-frame {
    width: 56px; /* the 24px portrait at exactly 2x (48px), inside a 2px plum mat and honey line, */
    height: 56px; /* so its pixels stay whole at 720p, 1080p (3x) and 1440p (4x) */
    padding: 2px;
    border-width: 2px;
    border-color: var(--honey);
    border-radius: 6px;
    background-color: var(--ink);
    overflow: hidden;
}

.portrait {
    flex-grow: 1; /* the hero's own, set by HudController */
}

.status-body {
    margin-left: 10px;
    flex-grow: 1;
    flex-shrink: 1;
}

.player-name {
    font-size: var(--text-label);
    color: var(--ink);
    margin-bottom: 3px;
}

/* Hearts: one per point of health, in one row. Up to 8 at full size; 9-12 a little smaller;
   past 12 a single heart and "7 / 14" (HudController adds .compact / .counted). */
.hearts-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.hearts {
    flex-direction: row;
    flex-wrap: nowrap;
}

.heart {
    width: 24px; /* drawn at 120x112, shown at 24x22 */
    height: 22px;
    margin: 0 2px 0 0;
    background-image: url("project://database/Assets/Art/UI/Heart.png");
    transition-property: scale, rotate, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back; /* a little overshoot, like a squishy toy */
}

.hearts.compact .heart {
    width: 17px;
    height: 16px;
    margin-right: 1px;
}

.hearts-count {
    display: none;
    font-size: var(--text-body);
    margin-left: 4px;
}

.hearts-count.visible {
    display: flex;
}

.heart.empty {
    background-image: url("project://database/Assets/Art/UI/HeartEmpty.png");
}

/* Gentle Mode: half a hit taken, so the next heart is broken in half */
.heart.half {
    background-image: url("project://database/Assets/Art/UI/HeartHalf.png");
}

/* Healing: refilled hearts pop for a moment */
.heart.pop {
    scale: 1.3 1.3;
}

/* Hurt: the heart just lost jumps up and tilts, then settles as an empty one */
.heart.hurt {
    scale: 1.25 1.25;
    rotate: -14deg;
    translate: 0 -4px;
}

/* The last heart left beats */
.heart.beat {
    scale: 1.15 1.15;
}

.magic-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

.magic-icon {
    width: 20px;
    height: 20px;
    margin-right: 5px;
    background-image: url("project://database/Assets/Art/UI/IconMagic.png");
}

.magic-bar {
    flex-grow: 1;
    height: 14px;
    margin-right: 2px;
}

/* The footer: level, experience and coins on the left, skill points on the right. Deliberately
   smaller and quieter than hearts and magic: soft ink, one small size, aligned on one line. */
.secondary-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

.level-badge {
    min-width: 22px;
    height: 18px;
    padding: 0 6px;
    font-size: var(--text-small);
    -unity-text-align: middle-center;
    color: var(--ink);
    background-color: var(--honey-light);
    border-width: 1px;
    border-color: var(--honey-shade);
    border-radius: 9px;
}

.xp-bar {
    width: 64px;
    height: 8px;
    margin: 0 12px 0 6px;
    border-width: 1px;
}

.gold-icon {
    width: 16px;
    height: 16px;
    background-image: url("project://database/Assets/Art/UI/IconCoin.png");
    transition-property: scale;
    transition-duration: 0.1s;
}

/* A coin came in */
.gold-icon.pop {
    scale: 1.4 1.4;
}

.gold-text {
    font-size: var(--text-small);
    color: var(--coin-text);
    margin-left: 4px;
    flex-grow: 1;
}

/* Unspent skill points: a little green-trimmed chip on the right */
.points-hint {
    font-size: var(--text-small);
    color: var(--good);
    padding: 0 7px;
    height: 18px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgba(46, 140, 70, 0.5);
    border-radius: 9px;
    background-color: rgba(46, 140, 70, 0.08);
    display: none;
}

.points-hint.visible {
    display: flex;
}

/* ---------- The spell slot ---------- */

.hotbar {
    flex-direction: row;
    align-items: flex-end;
}

/* A slot with its button underneath */
.hotbar-item {
    align-items: center;
    margin: 0 6px;
}

.slot {
    width: 66px;
    height: 66px;
    background-image: url("project://database/Assets/Art/UI/PanelCream.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
    -unity-slice-scale: 0.25px;
}

/* The hero's one spell */
.spell-slot {
    width: 72px;
    height: 72px;
    transition-property: scale;
    transition-duration: 0.12s;
}

/* Ready to cast: the slot's paper warms a little (no size change: calm) */
.spell-slot.ready {
    -unity-background-image-tint-color: rgb(255, 236, 170);
}

/* Cast! The slot dips for a moment and a four-point star flashes over it */
.spell-slot.cast {
    scale: 0.92 0.92;
}

.spell-flash {
    position: absolute;
    left: 12px;
    top: 10px;
    width: 48px;
    height: 48px;
    background-image: url("project://database/Assets/Art/UI/StarBurst.png");
    opacity: 0;
    scale: 0.6 0.6;
    rotate: 0deg;
    transition-property: opacity, scale, rotate;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.spell-flash.visible {
    opacity: 1;
    scale: 1.1 1.1;
    rotate: 45deg;
    transition-duration: 0.06s;
}

.slot-icon {
    position: absolute;
    left: 9px;
    top: 9px;
    width: 48px;
    height: 48px;
}

.spell-slot .slot-icon {
    left: 12px;
    top: 12px;
    width: 48px; /* 24px icon at 2x */
    height: 48px;
}

/* Not enough magic: the icon goes faded and grey-blue */
.slot.no-mana .slot-icon {
    -unity-background-image-tint-color: rgb(150, 150, 190);
    opacity: 0.6;
}

/* A shade over the icon that shrinks away as the spell recharges (height set in code) */
.slot-cooldown {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 48px;
    height: 0;
    background-color: rgba(74, 37, 69, 0.55);
}

.slot-cost {
    position: absolute;
    right: 8px;
    bottom: 7px;
    font-size: var(--text-small);
    color: rgb(30, 130, 150);
}

/* A button prompt: the same little key cap wherever a key is named on its own */
.spell-key {
    margin-top: 4px;
    padding: 1px 8px;
    font-size: var(--text-small);
    color: var(--ink);
    background-color: var(--honey-light);
    border-width: 1px;
    border-bottom-width: 2px; /* a key cap, a little raised */
    border-color: var(--ink);
    border-radius: 5px;
}

/* The ability slots (2 and 3) stay hidden until their skill is learned */
.future-slot {
    display: none;
}

/* The abilities' slots are a little smaller than the spell's, so the spell stays the star */
.ability-slot {
    transition-property: scale;
    transition-duration: 0.12s;
}

.ability-slot.cast {
    scale: 0.9 0.9;
}

.ability-slot .slot-cooldown {
    left: 9px;
    top: 9px;
}

.future-slot.unlocked {
    display: flex;
}

/* ---------- Help ---------- */

.help-pill {
    font-size: var(--text-label);
    color: var(--ink-soft);
    padding: 6px 12px 8px 12px;
}

.help-row {
    top: 120px;
}

.help {
    width: 420px;
    padding: 14px 20px 16px 20px;
    display: none;
}

.help.open {
    display: flex;
}

.help-line {
    font-size: var(--text-body);
    margin-top: 6px;
}

/* ---------- Hints and messages ---------- */

.prompt-row {
    bottom: 124px; /* above the spell slot and its key */
}

.interact-prompt {
    font-size: var(--text-body);
    padding: 6px 16px 8px 16px;
    display: none;
}

.interact-prompt.visible {
    display: flex;
}

.toast-row {
    top: 88px; /* below the boss bar */
}

.toast {
    font-size: var(--text-body);
    padding: 8px 18px 10px 18px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.toast.visible {
    opacity: 1;
}

/* ---------- Inventory ---------- */

.inventory {
    position: absolute;
    left: var(--margin);
    top: 150px; /* under the status card */
    width: 600px; /* the paper doll on the left, the bag on the right */
    padding: 12px 16px 14px 16px;
    display: none;
}

.inventory.open {
    display: flex;
}

.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.inventory-title {
    font-size: var(--text-title);
}

.inventory-close {
    font-size: var(--text-small);
    color: var(--ink-soft);
}

.inventory-body {
    flex-direction: row;
}

.inventory-side {
    flex: 1;
    margin-left: 14px;
}

/* The paper doll: the hero's own picture, big, with the worn slots set on the body */
.doll {
    width: 262px;
    height: 296px;
}

.doll-figure {
    position: absolute;
    left: 19px;
    top: 36px;
    width: 224px;
    height: 224px;
    -unity-background-scale-mode: scale-to-fit;
}

.doll-slot {
    position: absolute;
    width: 52px;
    height: 52px;
    margin: 0;
}

.doll-slot .slot-icon {
    left: 2px;
    top: 2px;
}

/* Where each one sits on the body (the figure is the 32px hero drawn at 7x) */
.doll-hat    { left: 166px; top: 4px; }
.doll-helm   { left: 105px; top: 62px; }
.doll-charm  { left: 40px;  top: 92px; }
.doll-armor  { left: 105px; top: 132px; }
.doll-weapon { left: 196px; top: 140px; }
.doll-ring   { left: 22px;  top: 166px; }
.doll-boots  { left: 105px; top: 232px; }

.equip-info {
    margin: 4px 0 8px 0;
}

.section-label {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-bottom: 4px;
}

.stat-line {
    font-size: var(--text-label);
    color: rgb(190, 90, 40);
}

/* What the worn equipment adds, under the spell damage */
.stat-line.gear {
    font-size: var(--text-small);
    color: rgb(46, 140, 70);
    white-space: normal;
}

.bag {
    flex-direction: row;
    flex-wrap: wrap;
}

.inv-slot {
    margin: 0 6px 6px 0;
}

.inv-slot:hover {
    -unity-background-image-tint-color: rgb(255, 226, 160);
}

.item-details {
    font-size: var(--text-small);
    white-space: normal;
    min-height: 34px;
}

/* ---------- Skill tree ---------- */

.skills-row {
    top: 110px;
}

.skills {
    width: 400px;
    padding: 14px 20px 14px 20px;
    display: none;
}

.skills.open {
    display: flex;
}

.skill-points {
    font-size: var(--text-label);
    color: rgb(46, 140, 70);
}

/* One hero, one path: a single column of four steps */
.skill-branches {
    flex-direction: row;
    justify-content: center;
    margin: 6px 0 10px 0;
}

.skill-branch {
    width: 280px;
    align-items: center;
}

.skill-node {
    width: 260px;
    height: 52px;
    padding: 6px 10px;
    justify-content: center;
    background-color: rgb(238, 226, 198);
    border-width: 2px;
    border-color: rgb(196, 176, 150);
    border-radius: 6px;
    opacity: 0.55; /* locked: needs the skill above, or a skill point */
}

.skill-node:hover {
    border-color: var(--ink);
}

.skill-node.available {
    opacity: 1;
    border-color: rgb(46, 140, 70);
}

.skill-node.learned {
    opacity: 1;
    border-color: rgb(164, 112, 40);
    background-color: rgb(250, 214, 120);
}

.skill-name {
    font-size: var(--text-label);
}

.skill-tag {
    font-size: var(--text-small);
    color: var(--ink-soft);
}

/* Steps 3 and 4 give a new ability: their tag is the magic purple */
.skill-node.ability .skill-tag {
    color: rgb(140, 90, 190);
}

.skill-link {
    width: 3px;
    height: 12px;
    background-color: rgb(196, 176, 150);
}

.skill-link.learned {
    background-color: rgb(222, 168, 70);
}

.skill-details {
    min-height: 34px;
}

/* ---------- Cooking: a recipe card, like the Stardew Valley guidebook's ---------- */

.cooking-row {
    top: 90px;
}

.cooking {
    width: 440px;
    padding: 14px 20px 14px 20px;
    display: none;
}

.cooking.open {
    display: flex;
}

.cooking-close:hover {
    color: var(--ink);
}

/* The card itself: warm paper with a ruled border, like an index card */
.recipe-card {
    background-color: rgb(255, 248, 228);
    border-width: 2px;
    border-color: rgb(214, 180, 120);
    border-radius: 6px;
    padding: 10px 14px 12px 14px;
    margin-bottom: 8px;
}

.recipe-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.recipe-dish-icon {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    transition-property: scale;
    transition-duration: 0.18s;
}

.recipe-dish-icon.pop {
    scale: 1.3 1.3;
}

.recipe-name {
    font-size: var(--text-title);
}

/* What it does, in the card's green (hearts and magic) */
.recipe-effect {
    font-size: var(--text-label);
    color: rgb(46, 140, 70);
}

.recipe-description {
    font-size: var(--text-small);
    color: var(--ink-soft);
    white-space: normal;
    margin-bottom: 8px;
}

/* One ingredient: its picture, its name (and where to find it, until you have it), x/y and a star */
.recipe-ingredient {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: rgb(244, 232, 206);
}

.recipe-ingredient.have {
    background-color: rgb(222, 240, 206);
}

.recipe-ingredient-icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    opacity: 0.55;
}

.recipe-ingredient.have .recipe-ingredient-icon {
    opacity: 1;
}

.recipe-ingredient-name {
    font-size: var(--text-label);
}

.recipe-ingredient-where {
    font-size: var(--text-small);
    color: var(--ink-soft);
    white-space: normal;
}

.recipe-count {
    font-size: var(--text-label);
    color: rgb(190, 90, 40);
    margin: 0 6px;
}

.recipe-ingredient.have .recipe-count {
    color: rgb(46, 140, 70);
}

.recipe-tick {
    width: 22px;
    height: 22px;
    background-image: url("project://database/Assets/Art/UI/PipStar.png");
    opacity: 0;
}

.recipe-ingredient.have .recipe-tick {
    opacity: 1;
}

.cook-button {
    margin-top: 8px;
    padding: 6px 12px;
    -unity-text-align: middle-center;
    font-size: var(--text-label);
    color: var(--ink-soft);
    background-color: rgb(232, 222, 204);
    border-radius: 6px;
}

.cook-button.ready {
    color: rgb(255, 255, 255);
    background-color: rgb(222, 120, 60);
}

.cook-button.ready:hover {
    background-color: rgb(236, 140, 70);
}

/* Just cooked: a happy green, not "find the ingredients" */
.cook-button.made {
    color: rgb(255, 255, 255);
    background-color: rgb(46, 140, 70);
}

.recipe-pages {
    margin-top: 6px;
    font-size: var(--text-small);
    color: var(--ink-soft);
    -unity-text-align: middle-center;
}

.cooking-message {
    min-height: 40px;
}

/* ---------- Dialogue ---------- */

.dialogue-row {
    bottom: 140px; /* above the bottom row */
}

.dialogue {
    flex-direction: row;
    align-items: flex-end;
    display: none;
}

.dialogue.open {
    display: flex;
}

/* When the hero speaks, the portrait moves to the right, like a classic RPG */
.dialogue.hero-speaking {
    flex-direction: row-reverse;
}

.dialogue-portrait-frame {
    width: 120px;
    height: 120px;
    padding: 12px;
    margin: 0 10px;
}

.dialogue-portrait {
    flex-grow: 1; /* 96px: the dragon's 32px portrait at 3x, heroes' 24px at 4x */
}

.dialogue-box {
    width: 560px;
    min-height: 120px;
    padding: 14px 22px 10px 20px;
}

.dialogue-speaker {
    font-size: var(--text-body);
    color: rgb(164, 112, 40);
    margin-bottom: 6px;
}

.dialogue-text {
    font-size: var(--text-body);
    white-space: normal;
    flex-grow: 1;
}

.dialogue-hint {
    font-size: var(--text-small);
    -unity-text-align: lower-right;
    color: var(--ink-soft);
}

/* ---------- Win / lose banner ---------- */

.banner-row {
    top: 34%;
}

.banner {
    align-items: center;
    padding: 18px 40px 18px 40px;
    display: none;
}

.banner.visible {
    display: flex;
}

.banner-title {
    font-size: 40px;
}

.banner.won .banner-title {
    color: rgb(46, 140, 70);
}

.banner.lost .banner-title {
    color: rgb(190, 50, 70);
}

.banner-subtitle {
    font-size: var(--text-body);
    margin-top: 6px;
    color: var(--ink-soft);
}

/* ---------- Pause menu ---------- */

.pause-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(30, 14, 34, 0.55); /* dim the game behind it */
    display: none;
}

.pause-screen.open {
    display: flex;
}

.pause {
    width: 400px;
    padding: 18px 22px 20px 22px;
    align-items: stretch;
}

.pause-title {
    font-size: 26px;
    color: rgb(164, 112, 40);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.pause-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin: 3px 0 3px 0;
    padding: 0 10px 0 10px;
    border-width: 2px;
    border-radius: 8px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

/* The row the keyboard / gamepad (or the mouse) is on. */
.pause-row.selected {
    border-color: rgb(222, 168, 70);
    background-color: rgba(255, 236, 170, 0.6);
}

.pause-button {
    justify-content: center;
    font-size: var(--text-title);
    -unity-font-style: bold;
    color: var(--ink);
}

.pause-name {
    font-size: var(--text-body);
    flex-grow: 1;
}

.pause-value {
    width: 120px;
    font-size: var(--text-body);
    -unity-text-align: middle-center;
    color: rgb(164, 112, 40);
}

.pause-dots {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.pause-dot {
    width: 14px;
    height: 14px;
    margin: 0 3px 0 3px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgb(164, 112, 40);
}

.pause-dot.on {
    background-color: rgb(222, 168, 70);
}

.pause-less,
.pause-more {
    width: 30px;
    height: 30px;
    font-size: var(--text-body);
    -unity-font-style: bold;
    color: var(--ink);
    background-color: rgba(222, 168, 70, 0.35);
    border-width: 0;
    border-radius: 15px;
    margin: 0;
    padding: 0;
}

.pause-less:hover,
.pause-more:hover {
    background-color: rgba(222, 168, 70, 0.8);
}

.pause-description {
    font-size: var(--text-label);
    color: var(--ink-soft);
    -unity-text-align: middle-center;
    margin: 0 0 6px 0;
}

/* ---------- Gentle Mode nap ---------- */

.sleep-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 30, 72); /* a soft night-time purple */
    opacity: 0;
}

.sleep-text {
    font-size: 48px;
    color: rgb(255, 236, 170);
}

.sleep-subtext {
    font-size: var(--text-title);
    color: rgb(220, 206, 240);
    margin-top: 8px;
}


/* ---------- Bag / Treasures tabs ---------- */

.tab-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.tab {
    font-size: var(--text-small);
    color: var(--ink-soft);
    padding: 2px 10px 3px 10px;
    margin-right: 4px;
    border-radius: 6px;
    background-color: rgb(236, 224, 196);
}

.tab:hover {
    color: var(--ink);
}

.tab.active {
    color: rgb(255, 255, 255);
    background-color: rgb(222, 168, 70);
}

/* The quick slots (2-5) show how many are left in the corner, and fade when you've run out */
.quick-slot .slot-cost {
    color: rgb(150, 100, 20);
}

/* ---------- Quest log ---------- */

.quests-row {
    top: 100px;
}

.quests {
    width: 480px;
    max-height: 520px;
    padding: 14px 20px 14px 20px;
    display: none;
}

.quests.open {
    display: flex;
}

.quest-empty {
    min-height: 40px;
}

.quest-list {
    flex-direction: column;
}

/* One quest: who gave it, what it is and where you're up to, and a picture of what to do next */
.quest-card {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(222, 168, 70);
    background-color: rgb(250, 238, 206);
}

.quest-card.done {
    border-color: rgb(196, 176, 150);
    background-color: rgb(236, 226, 204);
    opacity: 0.75;
}

.quest-portrait {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    border-radius: 6px;
    background-color: rgb(238, 226, 198);
    -unity-background-scale-mode: scale-to-fit;
}

.quest-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.quest-title {
    font-size: var(--text-body);
}

.quest-step {
    font-size: var(--text-small);
    color: var(--ink-soft);
    white-space: normal;
}

.quest-pips {
    flex-direction: row;
    margin-top: 3px;
}

.quest-pip {
    width: 12px;
    height: 12px;
    margin-right: 4px;
    border-radius: 6px;
    background-color: rgb(214, 198, 168);
}

.quest-pip.done {
    background-color: rgb(222, 168, 70);
}

.quest-next {
    width: 48px;
    height: 48px;
    margin-left: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.quest-star {
    width: 36px;
    height: 36px;
    margin-left: 10px;
    background-image: url("project://database/Assets/Art/UI/PipStar.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- Fountain menu: rest and save, or travel ---------- */

.fountain-row {
    top: 120px;
}

.fountain-menu {
    width: 380px;
    padding: 14px 20px 14px 20px;
    display: none;
}

.fountain-menu.open {
    display: flex;
}

.fountain-close:hover {
    color: var(--ink);
}

.fountain-option {
    padding: 8px 12px;
    margin-bottom: 6px;
    font-size: var(--text-body);
    border-radius: 6px;
    background-color: rgb(244, 232, 206);
    border-width: 2px;
    border-color: rgb(244, 232, 206);
}

.fountain-option:hover {
    border-color: var(--ink);
}

.fountain-option.selected {
    color: rgb(255, 255, 255);
    background-color: rgb(222, 120, 60);
    border-color: rgb(164, 112, 40);
}

.fountain-option.here {
    background-color: rgb(222, 240, 206);
}


/* ---------- Item tooltip ---------- */

.item-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    width: 270px;
    padding: 10px 14px 10px 14px;
    display: none;
}

.item-tooltip.visible {
    display: flex;
}

.tip-name {
    font-size: var(--text-label);
    -unity-font-style: bold;
    white-space: normal;
}

.tip-kind {
    font-size: var(--text-small);
    color: var(--ink-soft);
    margin-bottom: 4px;
}

.tip-desc {
    font-size: var(--text-small);
    white-space: normal;
}

.tip-stats {
    font-size: var(--text-small);
    color: rgb(46, 140, 70);
    white-space: normal;
    margin-top: 4px;
}

.tip-action {
    font-size: var(--text-small);
    color: var(--ink-soft);
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 6px;
}


/* ---------- World map ---------- */

.worldmap-row {
    top: 80px;
}

.worldmap {
    width: 800px;
    padding: 14px 20px 14px 20px;
    display: none;
}

.worldmap.open {
    display: flex;
}

.world-canvas {
    width: 760px;
    height: 380px;
    background-color: rgba(98, 80, 120, 0.12);
    border-radius: 6px;
}

.world-room {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-room.here {
    border-width: 2px;
    border-color: rgb(236, 176, 60);
}

.world-title {
    position: absolute;
    font-size: var(--text-small);
    color: var(--ink-soft);
    white-space: nowrap;
}

.world-title.here {
    color: rgb(190, 90, 40);
    -unity-font-style: bold;
}

.world-dot {
    position: absolute;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgb(60, 30, 70);
    font-size: var(--text-small);
    color: rgb(60, 30, 70);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    padding: 0;
}

.world-you {
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(210, 70, 80);
}

.world-fountain {
    background-color: rgb(90, 190, 240);
}

.world-fountain.dim {
    background-color: rgba(90, 190, 240, 0.45);
}

.world-gap {
    background-color: rgb(255, 214, 90);
}

.world-egg {
    background-color: rgb(176, 110, 220);
}
