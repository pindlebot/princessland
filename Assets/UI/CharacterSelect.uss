/* Character select screen. Reuses Hud.uss for Label colors and the 9-sliced .frame.
   The cards are cream storybook panels, so their text uses the HUD's plum inks. */

.select-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(14, 12, 22);
}

.select-title {
    font-size: 40px;
    color: rgb(232, 196, 104);
}

.select-subtitle {
    font-size: 14px;
    color: rgba(236, 228, 210, 0.6);
    margin: 6px 0 26px 0;
}

.cards {
    flex-direction: row;
}

.card {
    width: 300px;
    padding: 20px;
    margin: 0 16px;
    align-items: center;
    opacity: 0.6;
    scale: 0.95 0.95;
    transition-property: opacity, scale; /* the chosen card brightens and grows */
    transition-duration: 0.15s;
}

.card:hover {
    opacity: 0.85;
}

.card.selected {
    opacity: 1;
    scale: 1 1;
}

.card-key {
    position: absolute;
    left: 16px;
    top: 12px;
    font-size: 14px;
    color: rgb(128, 88, 118);
}

.card-portrait {
    width: 144px; /* 24px portrait at exactly 6x, so the pixels stay square */
    height: 144px;
    margin-bottom: 14px;
}

.card-name {
    font-size: 22px;
    color: rgb(164, 112, 40);
    margin-bottom: 6px;
}

.card-description {
    font-size: 13px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.start-button {
    margin-top: 30px;
    padding: 10px 28px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(20, 16, 24);
    background-color: rgb(232, 196, 104);
    border-width: 0;
    border-radius: 3px;
}

.start-button:hover {
    background-color: rgb(255, 222, 130);
}

/* Hero differences as pictures: a row of hearts, a row of magic orbs, and the spell flashing at its own speed. */
.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    min-height: 24px;
    margin-bottom: 4px;
}

.stat-row .magic-icon {
    margin: 0 2px 0 0;
}

.spell-demo {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 8px 0;
}

.spell-demo-icon {
    width: 48px; /* 24px icon at 2x */
    height: 48px;
    margin-right: 8px;
    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.1s;
}

.spell-demo-icon.cast {
    scale: 1.3 1.3;
}

.spell-demo-name {
    font-size: 16px;
    color: rgb(164, 112, 40);
}

/* "Both heroes can go everywhere": the one line that stops a child worrying about picking wrong. */
.both-heroes {
    margin-top: 20px;
    font-size: 15px;
    color: rgb(232, 196, 104);
}
