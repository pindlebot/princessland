<!--
  The title screen. TitleController fills in the three save slot cards from the save files;
  "Quit game" closes the game (your adventures are already saved).
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Hud.uss" />
    <Style src="project://database/Assets/UI/CharacterSelect.uss" />
    <Style src="project://database/Assets/UI/Title.uss" />

    <ui:VisualElement class="select-screen">
        <ui:Label class="select-title title-name" text="Tidecrown" />
        <ui:Label class="select-subtitle" text="Pick your adventure" />

        <ui:Button name="continue" class="start-button continue-button" text="Continue  [Enter]" />
        <ui:Label name="status" class="title-status" text="" />

        <ui:VisualElement class="cards slots">
            <ui:VisualElement name="slot-0" class="frame card slot">
                <ui:Label class="card-key" text="1" />
                <ui:VisualElement name="slot-portrait" class="slot-portrait" />
                <ui:Label name="slot-tag" class="slot-tag" text="" />
                <ui:Label name="slot-name" class="card-name" text="New adventure" />
                <ui:Label name="slot-place" class="slot-place" />
                <ui:Label name="slot-stats" class="slot-stats" />
                <ui:Button name="slot-erase" class="slot-erase" text="Erase" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-1" class="frame card slot">
                <ui:Label class="card-key" text="2" />
                <ui:VisualElement name="slot-portrait" class="slot-portrait" />
                <ui:Label name="slot-tag" class="slot-tag" text="" />
                <ui:Label name="slot-name" class="card-name" text="New adventure" />
                <ui:Label name="slot-place" class="slot-place" />
                <ui:Label name="slot-stats" class="slot-stats" />
                <ui:Button name="slot-erase" class="slot-erase" text="Erase" />
            </ui:VisualElement>
            <ui:VisualElement name="slot-2" class="frame card slot">
                <ui:Label class="card-key" text="3" />
                <ui:VisualElement name="slot-portrait" class="slot-portrait" />
                <ui:Label name="slot-tag" class="slot-tag" text="" />
                <ui:Label name="slot-name" class="card-name" text="New adventure" />
                <ui:Label name="slot-place" class="slot-place" />
                <ui:Label name="slot-stats" class="slot-stats" />
                <ui:Button name="slot-erase" class="slot-erase" text="Erase" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="quit" class="quit-button" text="Quit game" />
    </ui:VisualElement>
</ui:UXML>
