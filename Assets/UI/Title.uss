/* Title screen. Builds on CharacterSelect.uss (screen, title, cards, start button). */

.title-name {
    font-size: 52px;
}

/* Continue is the main thing on the screen when there is a save: bigger than anything else, with a glow. */
.continue-button {
    margin: 0 0 8px 0;
    padding: 14px 40px;
    font-size: 24px;
    border-width: 3px;
    border-color: rgb(255, 240, 190);
    border-radius: 6px;
}

.continue-button.selected {
    background-color: rgb(255, 222, 130);
}

/* One line saying what Enter (A) will do for the highlighted card. */
.title-status {
    font-size: 15px;
    color: rgba(236, 228, 210, 0.85);
    margin: 0 0 18px 0;
    min-height: 20px;
}

.title-status.warning {
    color: rgb(255, 150, 150);
}

/* A little badge: "Continue" on a saved adventure, "New" on an empty slot. */
.slot-tag {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(46, 140, 70);
}

.slot.empty .slot-tag {
    color: rgb(164, 112, 40);
}

/* Erase asked once: the card goes red and waits for the second click. */
.slot.erasing {
    border-width: 3px;
    border-color: rgb(190, 50, 70);
    border-radius: 6px;
}

.slot.erasing .slot-tag {
    color: rgb(190, 50, 70);
}

.slot {
    width: 240px;
    height: 290px;
    opacity: 1;      /* every slot is a choice: no dimmed "unselected" look */
    scale: 1 1;
    transition-property: scale;
}

.slot:hover,
.slot.selected {
    opacity: 1;
    scale: 1.04 1.04;
}

/* The keyboard/gamepad highlight: a soft gold glow around the card. */
.slot.selected {
    border-width: 3px;
    border-color: rgb(232, 196, 104);
    border-radius: 6px;
}

.slot-portrait {
    width: 120px; /* 24px portrait at 5x */
    height: 120px;
    margin: 12px 0 12px 0;
}

/* An empty slot shows a big plus instead of a portrait. */
.slot.empty .slot-portrait {
    background-image: none;
    border-width: 3px;
    border-color: rgba(128, 88, 118, 0.45);
    border-radius: 60px;
}

.slot.empty .card-name {
    color: rgb(128, 88, 118);
}

.slot-place {
    font-size: 15px;
}

.slot-stats {
    font-size: 13px;
    color: rgb(128, 88, 118);
    margin-top: 4px;
}

.slot-erase {
    position: absolute;
    bottom: 10px;
    font-size: 12px;
    color: rgb(128, 88, 118);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.slot-erase:hover {
    color: rgb(190, 50, 70);
}

/* A quiet text button under the slots: there if you want it, not competing with Continue. */
.quit-button {
    margin-top: 28px;
    padding: 6px 18px;
    font-size: 15px;
    color: rgb(150, 140, 170);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(150, 140, 170, 0.4);
    border-radius: 3px;
}

.quit-button:hover,
.quit-button.selected {
    color: rgb(232, 196, 104);
    border-color: rgb(232, 196, 104);
}
